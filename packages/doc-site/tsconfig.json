{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@kylinui/vue": ["../vue-ui/src/index.ts"],
      "@vue-ui/*": ["../vue-ui/src/*"]
